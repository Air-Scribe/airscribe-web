# Supabase Configuration
# Get these values from your Supabase Dashboard -> Settings -> API
# https://app.supabase.com/project/_/settings/api

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to expose in client-side code)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Transcription Service Configuration
# Optional: Override the default transcription service host
VITE_TRANSCRIPTION_HOST=stage.doctamate.com

# Development Server Configuration
# Optional: Vite dev server URL (usually auto-detected)
VITE_DEV_SERVER_URL=http://localhost:5173

# TCP Forwarding Configuration (toolbar bridge)
# Optional: Override default TCP forwarding settings
TRANSCRIPTION_FORWARD_HOST=127.0.0.1
TRANSCRIPTION_FORWARD_PORT=3006
