{
  "name": "airscribe-web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint . --cache",
    "stylelint": "stylelint '**/*.css' --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "npm run typecheck && npm run prettier && npm run lint && npm run build",
    "generate-api": "node scripts/generate-api-client.js",
    "generate-api:watch": "nodemon --watch ../backend --ext py --exec \"npm run generate-api\""
  },
  "dependencies": {
    "@hey-api/openapi-ts": "^0.84.3",
    "@mantine/core": "^8.3.1",
    "@mantine/form": "^8.3.1",
    "@mantine/hooks": "^8.3.1",
    "@mantine/notifications": "^8.3.9",
    "@mantine/tiptap": "^8.3.1",
    "@supabase/supabase-js": "^2.57.4",
    "@tabler/icons-react": "^3.34.0",
    "@tiptap/extension-link": "^3.4.4",
    "@tiptap/pm": "^3.4.4",
    "@tiptap/react": "^3.4.4",
    "@tiptap/starter-kit": "^3.4.4",
    "clsx": "^2.1.1",
    "mantine-form-zod-resolver": "^1.3.0",
    "motion": "^12.23.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.7.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.1",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.13.2",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
